---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="404 Not Found" description="The requested page does not exist.">
    <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
        <h1 class="text-9xl font-bold font-mono text-[var(--primary)] mb-4">
            404
        </h1>

        <p class="text-2xl font-medium text-neutral-900 dark:text-neutral-100 mb-2 font-mono">
            Segmentation Fault
        </p>
        <p class="text-neutral-500 dark:text-neutral-400 mb-8 max-w-md font-mono">
            Program terminated with signal SIGSEGV. Cannot access memory at requested address.
        </p>

        <a 
            href="/" 
            class="group flex items-center gap-2 px-6 py-3 ring-1 ring-neutral-300 dark:ring-neutral-700 bg-[var(--btn-regular-bg)] text-neutral-700 dark:text-neutral-300 hover:bg-[var(--primary)] hover:ring-[var(--primary)] hover:text-white dark:hover:text-neutral-900 rounded-xl transition-all duration-300 font-mono shadow-sm"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:-translate-x-1">
                <path d="m12 19-7-7 7-7"/>
                <path d="M19 12H5"/>
            </svg>
            cd ~/
        </a>
    </div>
</MainGridLayout>